<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#ADD8E6"
        tools:context=".MainActivity">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="5dp"
            android:text="Urządzenia Domowe"
            android:textSize="34sp" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="5dp"
            android:text="Autor: Albert" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="0dp"
                android:contentDescription="Pralka"
                android:scaleType="centerCrop"
                android:src="@drawable/pralka" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pralka"
                    android:textSize="24sp" />

            <EditText
                    android:id="@+id/editNumerPrania"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#87CEEB"
                    android:hint="Podaj nr prania 1..12"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:textColor="#000080"
                    android:textColorHint="#000080" />

            <Button
                    android:id="@+id/buttonZatwierdz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:backgroundTint="#4169E1"
                    android:text="Zatwierdź" />

            <TextView
                    android:id="@+id/textNumerPrania"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Numer prania: nie podano" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="0dp"
                android:contentDescription="Odkurzacz"
                android:scaleType="centerCrop"
                android:src="@drawable/odkurzacz" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odkurzacz"
                    android:textSize="24sp" />

            <Button
                    android:id="@+id/buttonOdkurzacz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:backgroundTint="#4169E1"
                    android:text="Włącz" />

            <TextView
                    android:id="@+id/textStanOdkurzacza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odkurzacz wyłączony" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: naładowany" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
